{
  "name": "orangehrm-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Cucumber and Playwright automation framework for OrangeHRM (Login -> PIM > Add Employee).",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:login": "cucumber-js --tags @login",
    "test:dry": "cucumber-js --dry-run",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium firefox webkit",
    "test:add-employee": "cucumber-js --tags \"@addEmployee\"",
    "test:validation": "cucumber-js --tags \"@validation\"",
    "test:employee-id": "cucumber-js --tags \"@employee-id\"",
    "test:login-details": "cucumber-js --tags \"@login-details\"",
    "test:photo": "cucumber-js --tags \"@photo\"",
    "test:ui": "cucumber-js --tags \"@ui\"",
    "test:positive": "cucumber-js --tags \"@positive\"",
    "test:boundary": "cucumber-js --tags \"@boundary\""
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
