# Copy file này thành .env rồi điền giá trị thật. File .env đã bị .gitignore chặn.
BASE_URL=https://opensource-demo.orangehrmlive.com

# Tài khoản đăng nhập (lấy trên trang login demo OrangeHRM hoặc hỏi trưởng nhóm)
ORANGEHRM_USERNAME=
ORANGEHRM_PASSWORD=

# chromium | firefox | webkit
BROWSER=chromium
# true = chạy ẩn, false = mở trình duyệt để xem
HEADLESS=false
